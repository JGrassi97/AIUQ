# Overrides for the AIUQ dashboard (copied to ~/.config/aiuq-dashboard.env by install.sh).
# Every value below is the default; uncomment to change.
#AIUQ_SOCKET=/home/jgrassi/.aiuq-dashboard/dash.sock   # set to empty to listen on AIUQ_BIND:AIUQ_PORT instead
#AIUQ_PORT=8765
#AIUQ_BIND=127.0.0.1
#AIUQ_GIT_REPO=https://github.com/JGrassi97/AIUQ.git
#AIUQ_SUPPORT_FOLDER=/work/users/jgrassi/AIUQ
#AIUQ_REFRESH=45
#AIUQ_SLOW_REFRESH=600
#AIUQ_AS_ROOT=/home/jgrassi/autosubmit
#AIUQ_AS_PYTHON=/home/jgrassi/miniconda3/bin/python
#AIUQ_REMOTE_HOST=felipe.polito.it
#AIUQ_REMOTE_USER=jgrassi
#AIUQ_REMOTE_PYTHON=python3
