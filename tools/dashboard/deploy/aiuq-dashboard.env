# Settings of the AIUQ dashboard (copied to ~/.config/aiuq-dashboard.env by install.sh).
# Edit the file in ~/.config, then: systemctl --user restart aiuq-dashboard

# --- Your site: required, there are no defaults -----------------------------------------------------
# HPC login node where the jobs run (the HOST of your platform in conf/platforms.yml), reached with
# key-based ssh from this machine, and your user there (default: your user on this machine).
AIUQ_REMOTE_HOST=
#AIUQ_REMOTE_USER=
# Where experiments live on the HPC: <SCRATCH_DIR>/<PROJECT>/<USER> of the platform.
AIUQ_REMOTE_BASE=
# Launcher: platform given to `autosubmit expid -H` (a name of conf/platforms.yml with job files in
# conf/jobs/<name>/) and the AIUQ support folder on the HPC (checkpoints, images, static files).
AIUQ_LAUNCH_PLATFORM=
AIUQ_SUPPORT_FOLDER=
# Launcher: experiment folders on the HPC may only be deleted below these roots (":"-separated),
# at <root>/<project>/<user>/<expid>. Usually the SCRATCH_DIR of the platform.
AIUQ_REMOTE_DELETE_ROOTS=

# --- Optional: every value below is the default ------------------------------------------------------
#AIUQ_GIT_REPO=https://github.com/JGrassi97/AIUQ.git
#AIUQ_AS_ROOT=$HOME/autosubmit                     # [local] path of ~/.autosubmitrc (write the full path)
#AIUQ_AS_PYTHON=$HOME/miniconda3/bin/python        # a Python that can import autosubmit (full path)
#AIUQ_REMOTE_PYTHON=python3
#AIUQ_SOCKET=$HOME/.aiuq-dashboard/dash.sock       # full path; empty: listen on AIUQ_BIND:AIUQ_PORT instead
#AIUQ_PORT=8765
#AIUQ_BIND=127.0.0.1
#AIUQ_REFRESH=45
#AIUQ_SLOW_REFRESH=600
